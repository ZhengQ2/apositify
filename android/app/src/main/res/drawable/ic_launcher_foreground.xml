        android:pathData="M226,293 a17,17 0 1 1 0,34 a17,17 0 1 1 0,-34 Z" />
    <path android:fillColor="#A9C3E2" android:pathData="M226,302 a8,8 0 1 1 0,16 a8,8 0 1 1 0,-16 Z" />

