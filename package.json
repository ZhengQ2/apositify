  "dependencies": {
    "jsqr": "^1.4.0",
    "lucide-react": "^1.22.0",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "vite": "^8.1.0"
  },
  "devDependencies": {
    "jimp": "^1.6.1",
    "jsdom": "^27.0.1"
  },
  "engines": {
    "node": "^20.19.0 || >=22.12.0"
  },
